# ===== 邮件发送 (SMTP) =====
# 以 QQ 邮箱为例：SMTP_HOST=smtp.qq.com  SMTP_PORT=465  SMTP_USER=你的QQ邮箱  SMTP_PASS=授权码(非登录密码)
# Gmail：smtp.gmail.com / 465 / 邮箱 / 应用专用密码
# 163：smtp.163.com / 465 / 邮箱 / 授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_account@qq.com
SMTP_PASS=your_authorization_code
# 收件人(可多个，用英文逗号分隔)
MAIL_TO=your_account@qq.com
# 发件人显示名(可选)
MAIL_FROM_NAME=产品机会雷达

# 是否额外附带日报文件(html/md)。true / false
ATTACH_FILE=false
# 附件格式：html 或 md
ATTACH_FORMAT=html

# ===== Reddit 官方 API (推荐配置，否则该源跳过) =====
# 在 https://www.reddit.com/prefs/apps 创建 "script" 类型应用获取
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# 自定义 User-Agent，遵守 Reddit API 规范，例如：windows:product-radar:v1.0 (by /u/yourname)
REDDIT_USER_AGENT=python:product-opportunity-radar:v1.0 (by /u/your_reddit_name)

# ===== Product Hunt 官方 GraphQL API (可选，留空则跳过) =====
# 在 https://www.producthunt.com/v2/oauth/applications 创建应用获取 Developer Token
PRODUCTHUNT_TOKEN=

# ===== LLM 智能研判 (DeepSeek，强烈推荐：质量提升最大的一步) =====
# 在 https://platform.deepseek.com 创建 API Key（充值几元可用很久）
# 留空则自动降级为纯关键词模式（仍可运行，但质量较低）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 需求强度阈值(0-100)，低于此分不进入"真实需求"区。越高越严格、越少而精
LLM_MIN_STRENGTH=55
# 单次最多送多少候选给 LLM（控制成本）
LLM_MAX_CANDIDATES=80
# 每批条数
LLM_BATCH_SIZE=12

# ===== 可选：Google Trends (默认关闭，pytrends 为非官方库) =====
ENABLE_GOOGLE_TRENDS=false
